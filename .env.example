# LLM（任意 OpenAI 兼容接口：OpenAI / DeepSeek / 通义百炼 / ollama 等）
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
# 可选：写正文和润色单独用更强的模型（强烈建议），不填则同上
LLM_WRITER_MODEL_NAME=

# 可选：模拟参数
# STORY_SCENE_ROUNDS=2            # 每个场景角色轮流行动几轮
# STORY_SCENE_MAX_CHARACTERS=3
# STORY_MAX_SCENES=2
# STORY_PREV_TAIL_CHARS=1500      # 写作时带入上一章原文结尾的字数
